---
import Layout from "@/layouts/Layout.astro";
import PortfolioHistoryChart from "@/components/portfolio/PortfolioHistoryChart";
import { createClient } from "@/lib/supabase";
import { YahooPriceClient, type DailyPrice } from "@/lib/portfolio/yahoo-client";
import { ArrowLeft, History } from "lucide-react";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data } = supabase
  ? await supabase
      .from("portfolio_history_points")
      .select("date,total_value,net_invested_capital,total_profit,benchmark_value,msci_world_value,base_currency")
      .order("date")
  : { data: null };
const rows = data ?? [];
let sp500Fallback: DailyPrice[] = [];
let msciWorldFallback: DailyPrice[] = [];
const firstDate = rows[0]?.date == null ? null : String(rows[0].date);
const lastDate = rows.at(-1)?.date == null ? null : String(rows.at(-1)?.date);
if (firstDate && lastDate && rows.some((row) => row.benchmark_value == null || row.msci_world_value == null)) {
  const priceClient = new YahooPriceClient();
  const [sp500, msciWorld] = await Promise.all([
    priceClient.getDaily("^SP500TR", firstDate, lastDate).catch(() => null),
    priceClient.getDaily("IWDA.L", firstDate, lastDate).catch(() => null),
  ]);
  sp500Fallback = sp500?.prices ?? [];
  msciWorldFallback = msciWorld?.prices ?? [];
}
function priceOnOrBefore(prices: DailyPrice[], date: string): number | null {
  let value: number | null = null;
  for (const price of prices) {
    if (price.date > date) break;
    value = price.close.toNumber();
  }
  return value;
}
const points = rows.map((row) => ({
  date: String(row.date),
  totalValue: Number(row.total_value),
  netInvestedCapital: Number(row.net_invested_capital),
  totalProfit: Number(row.total_profit),
  benchmarkValue:
    row.benchmark_value == null ? priceOnOrBefore(sp500Fallback, String(row.date)) : Number(row.benchmark_value),
  msciWorldValue:
    row.msci_world_value == null ? priceOnOrBefore(msciWorldFallback, String(row.date)) : Number(row.msci_world_value),
}));
const currency = String(data?.at(-1)?.base_currency ?? "PLN");
---

<Layout title="Historia portfela — MyPortfelik">
  <div class="min-h-screen bg-[oklch(0.975_0.008_85)] text-slate-950">
    <header class="border-b border-slate-200 bg-white/80">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
        <a href="/dashboard" class="text-lg font-semibold tracking-tight">MyPortfelik</a>
        <a
          href="/dashboard"
          class="inline-flex min-h-10 items-center gap-2 rounded-lg px-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
          ><ArrowLeft aria-hidden="true" className="size-4" /> Portfel</a
        >
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <div class="mb-10 max-w-3xl">
        <p class="flex items-center gap-2 text-sm font-medium text-indigo-800">
          <History aria-hidden="true" className="size-4" /> Historia od początku
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Jak zmieniał się Twój portfel</h1>
        <p class="mt-3 leading-7 text-slate-600">
          Wycena na koniec każdego dnia, odtworzona z pełnego raportu XTB, historycznych notowań i kursów NBP.
        </p>
      </div>
      {
        points.length > 0 ? (
          <PortfolioHistoryChart client:load points={points} currency={currency} />
        ) : (
          <div class="rounded-xl border border-slate-200 bg-white px-6 py-12 text-center">
            <>
              <p class="font-semibold">Historia nie została jeszcze utworzona</p>
              <p class="mt-2 text-sm text-slate-600">Zaimportuj ponownie pełny raport XTB na stronie portfela.</p>
            </>
          </div>
        )
      }
      <p class="mt-8 max-w-3xl text-xs leading-5 text-slate-500">
        Notowania dzienne pochodzą z zewnętrznego źródła rynkowego i mogą różnić się od wyceny XTB w ciągu dnia. Ostatni
        punkt jest uzgadniany z wartością raportu XTB.
      </p>
    </main>
  </div>
</Layout>
